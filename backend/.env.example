# ── Database Configuration ────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=samanvaya

# ── Authentication ─────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI / Ollama ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── GitHub Integration ─────────────────────────────────────
# Create at: https://github.com/settings/tokens (scopes: repo, read:org, read:user)
GITHUB_TOKEN=your_github_token_here
GITHUB_TIMEOUT=15

# Webhook secret — set when configuring GitHub webhooks
# GitHub → Repo → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=
