# ══════════════════════════════════════════════════════════
# SAMANVAYA CONFIGURATION
# ══════════════════════════════════════════════════════════

# ── Environment ────────────────────────────────────────────
# Options: development, staging, production
ENVIRONMENT=development
DEBUG=true

# ── Database Configuration ────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=samanvaya
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2

# ── Authentication ─────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CRITICAL: Use strong, unique value in production
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SECURE_COOKIES=false  # Set to true in production

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development: localhost origins
# Production: Replace with actual domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security & Rate Limiting ───────────────────────────────
RATE_LIMIT_ENABLED=false  # Set to true in production
MAX_REQUESTS_PER_MINUTE=100
MAX_LOGIN_ATTEMPTS=5

# ── AI / Ollama ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── GitHub Integration ─────────────────────────────────────
# Create token at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_TOKEN=
GITHUB_TIMEOUT=15

# Webhook secret — set when configuring GitHub webhooks
# GitHub → Repo → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=

# ── Logging ────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text

