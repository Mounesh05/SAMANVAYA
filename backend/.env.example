# SAMANVAYA backend configuration. Copy to .env and set your own values.
# Runtime: Python 3.12 (tested).

ENVIRONMENT=development
DEBUG=True
# Listener used by the development launcher (python start.py).
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

MONGO_URI=mongodb://localhost:27017
DB_NAME=samanvaya
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
# Default organization for first-account setup and legacy single-organization installs.
DEFAULT_ORG_ID=ORG001

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SECURE_COOKIES=False
ALLOW_SELF_REGISTRATION=false

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=True
MAX_REQUESTS_PER_MINUTE=100
MAX_LOGIN_ATTEMPTS=5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Seconds for one model call; raise on CPU-only hosts (e.g. 420)
OLLAMA_INFERENCE_TIMEOUT_SECONDS=120

# Fine-grained repository token: Metadata, Contents, Pull requests, Checks: Read.
# Optional CI provisioning additionally needs workflow/content write and secret access.
GITHUB_TOKEN=
GITHUB_TIMEOUT=15
GITHUB_WEBHOOK_SECRET=
# Check linked repositories for new/changed pull requests every N seconds (0 = off).
# Needed when GitHub cannot reach this API with webhooks, e.g. on localhost.
GITHUB_POLL_INTERVAL_SECONDS=180
QA_TEST_RESULTS_TOKEN=
SAMANVAYA_PUBLIC_API_URL=

LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
APM_ENABLED=False

# Optional isolated benchmark execution. Build worker images before enabling.
ALGORITHM_BENCHMARK_ENABLED=false

# Manual advisory PR workflow. Keep both off unless explicitly testing locally.
PR_MULTI_AGENT_INTERNAL_ENABLED=false
PR_MULTI_AGENT_MANUAL_ENABLED=false

# Multi-PR release rehearsal. Set the exact workflow path, file SHA-256 and required JUnit reports.
RELEASE_MANAGEMENT_ENABLED=false
RELEASE_TRUSTED_WORKFLOW_PATH=
RELEASE_TRUSTED_WORKFLOW_SHA256=
RELEASE_TRUSTED_BUILD_REF=main
RELEASE_REQUIRED_TEST_SUITES=
RELEASE_MIN_COVERAGE_PERCENT=0

# Isolated workers (OPS-03). Empty URL = development mode (local Docker CLI).
WORKER_BROKER_URL=
WORKER_BROKER_TOKEN=
WORKER_BROKER_TIMEOUT_SECONDS=180

# Background work limits (CQ-05, AI-02)
CODE_QUALITY_MAX_CONCURRENT_RUNS=2
CODE_QUALITY_MAX_PENDING_PER_ORG=20
PR_WORKFLOW_MAX_ACTIVE_PER_ACTOR=3
PR_WORKFLOW_MAX_ACTIVE_PER_ORG=20
PR_WORKFLOW_MAX_ACTIVE_TOTAL=100
PR_AGENT_SPECIALIST_TIMEOUT_SECONDS=30

# EV-05: manual baseline scores stay off until a calibrated policy is approved
EVALUATION_HUMAN_BASELINE_ENABLED=false
