      {
        "sha": "f26b3d71355dc2cd1bd328ebd418f8713926b7aa",
        "filename": "backend/app/advanced_algorithms.py",
        "status": "added",
        "additions": 137,
        "deletions": 0,
        "changes": 137,
        "blob_url": "https://github.com/Mounesh05/taskflow-samanvaya-lab/blob/8ad02ac50587c6bb668dc480ae68efdc9f411b68/backend%2Fapp%2Fadvanced_algorithms.py",
        "raw_url": "https://github.com/Mounesh05/taskflow-samanvaya-lab/raw/8ad02ac50587c6bb668dc480ae68efdc9f411b68/backend%2Fapp%2Fadvanced_algorithms.py",
        "contents_url": "https://api.github.com/repos/Mounesh05/taskflow-samanvaya-lab/contents/backend%2Fapp%2Fadvanced_algorithms.py?ref=8ad02ac50587c6bb668dc480ae68efdc9f411b68",
        "patch": "@@ -0,0 +1,137 @@\n+\"\"\"Dependency traversal and priority scheduling.\n+\n+Pure deterministic functions for controlled algorithm evaluation.\n+\"\"\"\n+\n+import heapq\n+from collections import deque\n+\n+from .models import Task\n+\n+\n+def schedule_with_heap(tasks: list[Task]) -> list[Task]:\n+    \"\"\"Highest priority first, retaining input order for ties.\"\"\"\n+    heap = [\n+        (-task.priority, index, task)\n+        for index, task in enumerate(tasks)\n+    ]\n+\n+    heapq.heapify(heap)\n+\n+    ordered = []\n+\n+    while heap:\n+        _, _, task = heapq.heappop(heap)\n+        ordered.append(task)\n+\n+    return ordered\n+\n+\n+def schedule_with_repeated_sort(\n+    tasks: list[Task],\n+) -> list[Task]:\n+    \"\"\"Reference implementation for scheduling comparison.\"\"\"\n+    remaining = list(enumerate(tasks))\n+    ordered = []\n+\n+    while remaining:\n+        remaining.sort(\n+            key=lambda item: (-item[1].priority, item[0])\n+        )\n+        _, task = remaining.pop(0)\n+        ordered.append(task)\n+\n+    return ordered\n+\n+\n+def bfs_dependencies(\n+    graph: dict[str, list[str]],\n+    start: str,\n+) -> list[str]:\n+    \"\"\"Return reachable nodes in breadth-first order.\"\"\"\n+    if start not in graph:\n+        return []\n+\n+    visited = {start}\n+    queue = deque([start])\n+    order = []\n+\n+    while queue:\n+        node = queue.popleft()\n+        order.append(node)\n+\n+        for neighbor in graph.get(node, []):\n+            if neighbor not in visited:\n+                visited.add(neighbor)\n+                queue.append(neighbor)\n+\n+    return order\n+\n+\n+def dfs_dependencies(\n+    graph: dict[str, list[str]],\n+    start: str,\n+) -> list[str]:\n+    \"\"\"Return reachable nodes in depth-first order.\"\"\"\n+    if start not in graph:\n+        return []\n+\n+    visited = set()\n+    stack = [start]\n+    order = []\n+\n+    while stack:\n+        node = stack.pop()\n+\n+        if node in visited:\n+            continue\n+\n+        visited.add(node)\n+        order.append(node)\n+\n+        for neighbor in reversed(graph.get(node, [])):\n+            if neighbor not in visited:\n+                stack.append(neighbor)\n+\n+    return order\n+\n+\n+def has_dependency_cycle(\n+    graph: dict[str, list[str]],\n+) -> bool:\n+    \"\"\"Detect cycles in a directed dependency graph.\"\"\"\n+    nodes = set(graph)\n+\n+    for neighbors in graph.values():\n+        nodes.update(neighbors)\n+\n+    WHITE, GRAY, BLACK = 0, 1, 2\n+    state = {node: WHITE for node in nodes}\n+\n+    for start in nodes:\n+        if state[start] != WHITE:\n+            continue\n+\n+        state[start] = GRAY\n+        stack = [(start, iter(graph.get(start, [])))]\n+\n+        while stack:\n+            node, neighbors = stack[-1]\n+\n+            try:\n+                neighbor = next(neighbors)\n+            except StopIteration:\n+                state[node] = BLACK\n+                stack.pop()\n+                continue\n+\n+            if state[neighbor] == GRAY:\n+                return True\n+\n+            if state[neighbor] == WHITE:\n+                state[neighbor] = GRAY\n+                stack.append(\n+                    (neighbor, iter(graph.get(neighbor, [])))\n+                )\n+\n+    return False\n\\ No newline at end of file"
      },
      {
        "sha": "41bfb3bfdb995c2e9caa38d7ba0a73e20b144876",
        "filename": "backend/tests/test_advanced_algorithms.py",
        "status": "added",
        "additions": 110,
        "deletions": 0,
        "changes": 110,
        "blob_url": "https://github.com/Mounesh05/taskflow-samanvaya-lab/blob/8ad02ac50587c6bb668dc480ae68efdc9f411b68/backend%2Ftests%2Ftest_advanced_algorithms.py",
        "raw_url": "https://github.com/Mounesh05/taskflow-samanvaya-lab/raw/8ad02ac50587c6bb668dc480ae68efdc9f411b68/backend%2Ftests%2Ftest_advanced_algorithms.py",
        "contents_url": "https://api.github.com/repos/Mounesh05/taskflow-samanvaya-lab/contents/backend%2Ftests%2Ftest_advanced_algorithms.py?ref=8ad02ac50587c6bb668dc480ae68efdc9f411b68",
        "patch": "@@ -0,0 +1,110 @@\n+from app.advanced_algorithms import (\n+    bfs_dependencies,\n+    dfs_dependencies,\n+    has_dependency_cycle,\n+    schedule_with_heap,\n+    schedule_with_repeated_sort,\n+)\n+from app.models import Task\n+\n+\n+def sample_tasks():\n+    return [\n+        Task(id=\"1\", title=\"Write tests\", priority=2),\n+        Task(id=\"2\", title=\"Fix API\", priority=5),\n+        Task(id=\"3\", title=\"Review PR\", priority=5),\n+        Task(id=\"4\", title=\"Update docs\", priority=1),\n+    ]\n+\n+\n+def test_heap_scheduling_priority():\n+    result = schedule_with_heap(sample_tasks())\n+\n+    assert [task.id for task in result] == [\n+        \"2\", \"3\", \"1\", \"4\"\n+    ]\n+\n+\n+def test_scheduling_implementations_agree():\n+    tasks = sample_tasks()\n+\n+    assert schedule_with_heap(tasks) == (\n+        schedule_with_repeated_sort(tasks)\n+    )\n+\n+\n+def test_scheduling_does_not_mutate_input():\n+    tasks = sample_tasks()\n+    original = tasks.copy()\n+\n+    schedule_with_heap(tasks)\n+\n+    assert tasks == original\n+\n+\n+def test_empty_heap():\n+    assert schedule_with_heap([]) == []\n+\n+\n+def test_bfs_dependencies():\n+    graph = {\n+        \"A\": [\"B\", \"C\"],\n+        \"B\": [\"D\"],\n+        \"C\": [\"E\"],\n+        \"D\": [],\n+        \"E\": [],\n+    }\n+\n+    assert bfs_dependencies(graph, \"A\") == [\n+        \"A\", \"B\", \"C\", \"D\", \"E\"\n+    ]\n+\n+\n+def test_dfs_dependencies():\n+    graph = {\n+        \"A\": [\"B\", \"C\"],\n+        \"B\": [\"D\"],\n+        \"C\": [\"E\"],\n+        \"D\": [],\n+        \"E\": [],\n+    }\n+\n+    assert dfs_dependencies(graph, \"A\") == [\n+        \"A\", \"B\", \"D\", \"C\", \"E\"\n+    ]\n+\n+\n+def test_missing_start():\n+    graph = {\"A\": [\"B\"]}\n+\n+    assert bfs_dependencies(graph, \"unknown\") == []\n+    assert dfs_dependencies(graph, \"unknown\") == []\n+\n+\n+def test_cycle_detected():\n+    graph = {\n+        \"A\": [\"B\"],\n+        \"B\": [\"C\"],\n+        \"C\": [\"A\"],\n+    }\n+\n+    assert has_dependency_cycle(graph) is True\n+\n+\n+def test_acyclic_graph():\n+    graph = {\n+        \"A\": [\"B\", \"C\"],\n+        \"B\": [\"D\"],\n+        \"C\": [\"D\"],\n+        \"D\": [],\n+    }\n+\n+    assert has_dependency_cycle(graph) is False\n+\n+\n+def test_self_cycle():\n+    assert has_dependency_cycle({\"A\": [\"A\"]}) is True\n+\n+\n+def test_empty_graph():\n+    assert has_dependency_cycle({}) is False\n\\ No newline at end of file"
      }
