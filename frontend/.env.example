# Optional absolute API base URL. Include /api, e.g. https://api.example.com/api.
# Leave empty to use same-origin /api (recommended for Docker/Nginx).
VITE_API_URL=

# Legacy alias; VITE_API_URL takes precedence.
VITE_API_BASE_URL=

# Optional target for the local Vite development proxy.
VITE_DEV_API_TARGET=http://localhost:8000
