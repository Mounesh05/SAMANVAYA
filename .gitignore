# Samanvaya repository-wide ignore rules
# Keep source files, configuration templates, and reproducible build inputs tracked.

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.direnv/

# Packaging and distribution
build/
dist/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST

# Python tooling and test output
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.pylint.d/
.pybuilder/
.cache/
.ipynb_checkpoints/
*.sage.py
profile_default/
ipython_config.py

# Python local configuration and runtime data
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache/
.scrapy/
celerybeat-schedule
celerybeat.pid

# Python dependency-manager state
.python-version
Pipfile.lock
poetry.lock
pdm.lock
.pdm.toml
__pypackages__/

